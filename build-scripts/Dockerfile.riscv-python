# Dockerfile.riscv-python
FROM riscv64/ubuntu:24.04

# 设置环境变量避免交互式提示
ENV DEBIAN_FRONTEND=noninteractive

# 安装编译依赖
RUN apt-get update && apt-get install -y \
    wget \
    curl \
    git \
    build-essential \
    libssl-dev \
    libffi-dev \
    zlib1g-dev \
    libbz2-dev \
    libreadline-dev \
    libsqlite3-dev \
    libncurses5-dev \
    libgdbm-dev \
    libdb-dev \
    libexpat1-dev \
    liblzma-dev \
    tk-dev \
    uuid-dev \
    make \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# 安装 pyenv 来管理多版本 Python
RUN curl https://pyenv.run | bash

# 配置 pyenv 环境变量
ENV PYENV_ROOT="/root/.pyenv"
ENV PATH="$PYENV_ROOT/bin:$PATH"

# 初始化 pyenv
RUN echo 'eval "$(pyenv init -)"' >> ~/.bashrc

# 编译并安装多个 Python 版本
# 注意：这会在构建镜像时完成，只需一次
RUN eval "$(pyenv init -)" && \
    pyenv install 3.10.15 && \
    pyenv install 3.11.10 && \
    pyenv install 3.12.8 && \
    pyenv install 3.13.1 && \
    # Python 3.14 需要从 main 分支编译
    git clone https://github.com/python/cpython.git /tmp/cpython-3.14 && \
    cd /tmp/cpython-3.14 && \
    git checkout main && \
    ./configure --prefix=/root/.pyenv/versions/3.14.0-dev && \
    make -j$(nproc) && \
    make install && \
    pyenv versions

# 为每个版本安装并升级 pip
RUN eval "$(pyenv init -)" && \
    for version in 3.10.15 3.11.10 3.12.8 3.13.1 3.14.0-dev; do \
        pyenv global $version && \
        python -m pip install --upgrade pip; \
    done

# 设置默认 Python 版本（可选）
ENV PATH="/root/.pyenv/shims:/root/.pyenv/bin:$PATH"

CMD ["/bin/bash"]
